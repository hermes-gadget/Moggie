# /etc/shadow -- every password is locked ('!').
#
# Login policy:
#   * no password authenticates anything on this device;
#   * the UART console gets a root shell directly from getty (inittab),
#     which is the same trust level as having the speaker on the bench;
#   * dropbear, when enabled, runs with -s (password auth disabled) and
#     accepts only the keys provisioned under /jffs/ssh/.
root:!::0:99999:7:::
daemon:!::0:99999:7:::
nobody:!::0:99999:7:::
