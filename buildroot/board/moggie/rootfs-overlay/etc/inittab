# /etc/inittab -- Moggie
#
# PID 1 is busybox init. rcS does all one-shot setup; sonosd is respawned by
# init so a crash restarts it (busybox init throttles runaway respawns).
#
# The console runs a shell directly: root's password is locked in /etc/shadow
# and no password-authenticated login exists anywhere on the device. Physical
# UART access is the trust boundary. SSH is opt-in and key-only; see rcS.

::sysinit:/etc/init.d/rcS

ttyS0::respawn:/sbin/getty -L -l /bin/sh 115200 ttyS0 vt100

::respawn:/usr/sbin/sonosd

::restart:/sbin/init
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/umount -a -r
::shutdown:/bin/sync
