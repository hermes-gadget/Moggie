# Moggie -- Sonos Play:5 Gen 1 (PowerPC MPC8315, e300c3).
# Generated by scripts/build-rootfs.sh; edit here, not in out/.
#
# Toolchain: the pinned Bootlin external toolchain from toolchain.lock.
# No internal toolchain is built -- that would be hours and gigabytes.

# --- architecture --------------------------------------------------------
BR2_powerpc=y
BR2_powerpc_e300c3=y
BR2_ARCH="powerpc"
BR2_ENDIAN="BIG"
BR2_BINFMT_ELF=y
# hard float: the e300c3 has an FPU and the vendor userspace uses it
# BR2_SOFT_FLOAT is not set

# --- toolchain -----------------------------------------------------------
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
# Empty: the compiler is found through PATH, which scripts/build-rootfs.sh
# points at the pinned toolchain. Keeping an absolute path out of here means
# the defconfig does not encode one developer's checkout layout.
BR2_TOOLCHAIN_EXTERNAL_PATH=""
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="powerpc-buildroot-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
# The toolchain physically ships 5.10 headers (Bootlin 2026.08-1) and the
# target kernel is 2.6.35. Buildroot's check-kernel-headers.sh is strict for
# any series that is not the newest, so declaring 2.6.x or 3.0 fails with
# "expected 3.0.x, got 5.10.x"; 2.6.x is not even expressible (it selects no
# BR2_TOOLCHAIN_HEADERS_AT_LEAST, and the script then builds KERNEL_VERSION()
# from an empty string). 5.10 is therefore the only value that builds, and it
# is the truthful description of the toolchain -- NOT of the target. See
# buildroot.lock ("Known incompatibility") and buildroot/MANIFEST.md.
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# glibc 2.44 has no Sun RPC; leaving this on fails check_glibc_rpc_feature.
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
# Buildroot's external-toolchain check is an exact match: if the toolchain
# can compile C++/OpenMP (this one can), the option must be selected or the
# build stops with "not selected but is available". Nothing in the rootfs
# uses either; the cost is libstdc++/libgomp on the target (see MANIFEST).
BR2_TOOLCHAIN_EXTERNAL_CXX=y
# BR2_TOOLCHAIN_EXTERNAL_FORTRAN is not set
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
# BR2_TOOLCHAIN_EXTERNAL_DLANG is not set
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP_STRONG=y

# --- build ---------------------------------------------------------------
BR2_OPTIMIZE_S=y
BR2_REPRODUCIBLE=y
BR2_TARGET_OPTIMIZATION=""

# --- system --------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="moggie"
BR2_TARGET_GENERIC_ISSUE="Moggie -- Sonos Play:5 Gen 1"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_DHCP=""
BR2_INIT_BUSYBOX=y
# The 2.6.35 kernel has no CONFIG_DEVTMPFS, so /dev is built statically and
# rcS layers a tmpfs + mdev on top at boot.
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_ROOTFS_STATIC_DEVICE_TABLE="$(BR2_EXTERNAL_MOGGIE_PATH)/board/moggie/device_table_dev.txt"
BR2_ROOTFS_DEVICE_TABLE="$(BR2_EXTERNAL_MOGGIE_PATH)/board/moggie/device_table.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MOGGIE_PATH)/board/moggie/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MOGGIE_PATH)/board/moggie/post-build.sh"

# --- packages ------------------------------------------------------------
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MOGGIE_PATH)/board/moggie/busybox.fragment"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_MTD=y
BR2_PACKAGE_MTD_MKFSJFFS2=y
BR2_PACKAGE_MTD_FLASH_ERASE=y
BR2_PACKAGE_MTD_NANDWRITE=y
BR2_PACKAGE_MTD_NANDDUMP=y
BR2_PACKAGE_MTD_FLASHCP=y
BR2_PACKAGE_MTD_SUMTOOL=y
# UBI is not used on this hardware (raw mtd + jffs2 + squashfs). Every UBI
# tool must be disabled explicitly: ubihealthd defaults to y and *selects*
# the hidden BR2_PACKAGE_MTD_UBIFS_UTILS, which builds and installs the whole
# UBI suite (~223 KiB compressed) even when the individual tools are off.
# BR2_PACKAGE_MTD_UBIATTACH is not set
# BR2_PACKAGE_MTD_UBICRC32 is not set
# BR2_PACKAGE_MTD_UBIDETACH is not set
# BR2_PACKAGE_MTD_UBIFORMAT is not set
# BR2_PACKAGE_MTD_UBIHEALTHD is not set
# BR2_PACKAGE_MTD_UBIMKVOL is not set
# BR2_PACKAGE_MTD_UBINFO is not set
# BR2_PACKAGE_MTD_UBINIZE is not set
# BR2_PACKAGE_MTD_UBIRENAME is not set
# BR2_PACKAGE_MTD_UBIRMVOL is not set
# BR2_PACKAGE_MTD_UBIRSVOL is not set
# BR2_PACKAGE_MTD_UBIUPDATEVOL is not set
# BR2_PACKAGE_MTD_UBIBLOCK is not set
# BR2_PACKAGE_MTD_MTD_DEBUG is not set
# BR2_PACKAGE_MTD_NANDTEST is not set
# libmosquitto only -- a broker on a 32 MB speaker is pointless.
BR2_PACKAGE_MOSQUITTO=y
# BR2_PACKAGE_MOSQUITTO_BROKER is not set
BR2_PACKAGE_SONOSD=y

# --- root filesystem -----------------------------------------------------
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_128K=y
# Raw image stays unpadded; scripts/build-rootfs.sh pads to the 128 KiB NAND
# eraseblock for the flashable artifact and measures both.
# BR2_TARGET_ROOTFS_SQUASHFS_PAD is not set
# gzip/zlib only: the 2.6.35 kernel has CONFIG_SQUASHFS with zlib and no
# XZ/LZMA decoder. EXTREME_COMP turns on -Xcompression-level 9.
BR2_TARGET_ROOTFS_SQUASHFS4_GZIP=y
BR2_TARGET_ROOTFS_SQUASHFS_EXTREME_COMP=y

